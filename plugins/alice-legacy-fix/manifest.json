{
  "format": 1,
  "id": "alice-legacy-fix",
  "version": "0.1.0-beta.2",
  "api": 2,
  "engine": "native",
  "title": {
    "ru": "Алиса: старые прошивки (бета)",
    "en": "Alice: legacy firmware (beta)"
  },
  "description": {
    "ru": "Новый голосовой стек для поддерживаемой старой прошивки. Комплект автоматически скачивается с GitHub и проверяется по SHA-256. Сначала проверка совместимости; для подробного журнала нужен Homebrew 0.5.4.",
    "en": "Newer voice framework for supported legacy firmware. Automatically downloads a SHA-256-pinned bundle from GitHub. Inspection first; Homebrew 0.5.4 retains diagnostics."
  },
  "author": "Alice Homebrew",
  "permissions": [
    "system.full-access",
    "log.write"
  ],
  "capabilities": [
    "audio.playback",
    "audio.capture",
    "filesystem.read",
    "filesystem.write",
    "system.processes"
  ],
  "runtime_storage_bytes": 33554432,
  "module_sha256": "dff9d76dcc01cdafadb9ea78961288d5aaba54a99936f417aa42a6e7c6b139ca",
  "config": [
    {
      "key": "mode",
      "label": {
        "ru": "Режим работы",
        "en": "Mode"
      },
      "type": "select",
      "default": "inspect",
      "options": [
        {
          "value": "inspect",
          "label": {
            "ru": "Только проверить совместимость",
            "en": "Inspect compatibility only"
          }
        },
        {
          "value": "run-new",
          "label": {
            "ru": "Запустить новый стек (экспериментально)",
            "en": "Run newer framework (experimental)"
          }
        }
      ]
    },
    {
      "key": "bundle-url",
      "label": {
        "ru": "Адрес комплекта (пусто — автоматически с GitHub)",
        "en": "Bundle URL (empty — automatic GitHub download)"
      },
      "type": "text",
      "default": "",
      "max_length": 512
    }
  ]
}
